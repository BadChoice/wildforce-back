{
  "openapi": "3.1.0",
  "info": {
    "title": "Wildforce API",
    "version": "1.0.0",
    "description": "API for Wildforce mobile clients. Authenticate with a Sanctum bearer token,\nthen use the sync endpoints to exchange user-owned records.\n"
  },
  "servers": [
    {
      "url": "http://wildforce.test"
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Media"
    },
    {
      "name": "Account"
    },
    {
      "name": "Feedback"
    },
    {
      "name": "Subscriptions"
    },
    {
      "name": "Coaching"
    },
    {
      "name": "Sync"
    },
    {
      "name": "Workouts"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a user and issue a bearer token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in and issue a bearer token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Sign in with Google and issue a bearer token",
        "description": "Verifies a Google OpenID Connect ID token before signing in or creating the user.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleAuthenticationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing user authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "201": {
            "description": "User registered and authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "409": {
            "description": "The verified email already belongs to an account with another sign-in method."
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/auth/apple": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Sign in with Apple and issue a bearer token",
        "description": "Exchanges the native Apple authorization code on the server. The optional full name is only used while creating a new user, because Apple may provide it only once.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppleAuthenticationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing Apple identity authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "201": {
            "description": "New user created from an Apple identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/account/identities": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "List the authenticated user's linked sign-in identities",
        "responses": {
          "200": {
            "description": "Linked identities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserIdentityCollection"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/api/account/identities/apple": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Link Apple to the authenticated user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkAppleIdentityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apple was already linked to this user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserIdentity"
                }
              }
            }
          },
          "201": {
            "description": "Apple linked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserIdentity"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "delete": {
        "tags": [
          "Account"
        ],
        "summary": "Unlink Apple from the authenticated user",
        "responses": {
          "204": {
            "description": "Apple unlinked, or was not linked"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/account/identities/google": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Link Google to the authenticated user",
        "description": "Verifies the Google OpenID Connect ID token before linking the Google account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleIdentityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Google account already linked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserIdentityResponse"
                }
              }
            }
          },
          "201": {
            "description": "Google account linked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserIdentityResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "409": {
            "description": "The Google account is linked to another user."
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "delete": {
        "tags": [
          "Account"
        ],
        "summary": "Unlink Google from the authenticated user",
        "responses": {
          "204": {
            "description": "Google account unlinked"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/user": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get the authenticated user",
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/api/users/avatar": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "Upload the authenticated user's public avatar",
        "description": "Stores a PNG at `avatars/{user-id}.png` in the public `wildfit` Supabase bucket.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "image"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "PNG image up to 2 MiB."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Avatar uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "example": "avatars/018f70f9-66a0-7a26-a4f8-8e0e1433f50e.png"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/body-progress-photo-sessions/{bodyProgressPhotoSession}/photos/{angle}": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "Upload a private body progress photo",
        "description": "Stores a JPEG on the default private S3 disk and updates the matching photo path on the session.",
        "parameters": [
          {
            "name": "bodyProgressPhotoSession",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "angle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "profile",
                "front",
                "torso"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "image"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG image up to 5 MiB."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Progress photo uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "example": "018f70f9-66a0-7a26-a4f8-8e0e1433f50e-front.jpg"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "description": "Progress photo session does not belong to the authenticated user."
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/feedback": {
      "post": {
        "tags": [
          "Feedback"
        ],
        "summary": "Email feedback from the authenticated user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Feedback accepted and emailed."
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/subscription/redeem-code": {
      "post": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Redeem a demo access code",
        "description": "Replaces the authenticated user's trial subscription with a demo subscription.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemDemoCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demo subscription activated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemDemoCodeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/account/coaches": {
      "get": {
        "tags": [
          "Coaching"
        ],
        "summary": "Get the authenticated user's active coaches",
        "responses": {
          "200": {
            "description": "Active coaches assigned to the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachCollection"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/api/workout-plans/generate": {
      "post": {
        "tags": ["Workouts"],
        "summary": "Generate a one-week workout-plan draft",
        "description": "Generates a draft from the authenticated user's training profile and recent history. The response is not persisted; save and sync it through the existing workout-plan flow.",
        "responses": {
          "200": {
            "description": "Generated workout-plan draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutPlanGenerationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "description": "An active subscription, trial, or demo access is required."
          }
        }
      }
    },
    "/api/sync/push": {
      "post": {
        "tags": [
          "Sync"
        ],
        "summary": "Push changed records for a registered resource",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncPushRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synchronized records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/sync/pull": {
      "get": {
        "tags": [
          "Sync"
        ],
        "summary": "Pull changed records for a registered resource",
        "parameters": [
          {
            "$ref": "#/components/parameters/SyncResource"
          },
          {
            "$ref": "#/components/parameters/UpdatedAfter"
          }
        ],
        "responses": {
          "200": {
            "description": "Changed records and the requested resource name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/sync/pull/batch": {
      "post": {
        "tags": [
          "Sync"
        ],
        "summary": "Pull changed flat-resource records in stable, paginated order",
        "description": "The first request supplies the resources and their watermarks. Later requests\nsupply only the opaque `cursor` returned by the prior response. Workout-day\nand nutrition-plan graphs, plus nutrition-log media, are not available here.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchSyncPullRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A page of changed records. `next_cursor` is null on the final page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchSyncPullResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/sync/workout-days": {
      "get": {
        "tags": [
          "Sync"
        ],
        "summary": "Pull workout days and templates with their blocks, exercises, and results",
        "description": "Each workout day includes `kind`: `workout` for an executable workout or `template` for a reusable coach-owned workout day.",
        "parameters": [
          {
            "$ref": "#/components/parameters/UpdatedAfter"
          }
        ],
        "responses": {
          "200": {
            "description": "Changed workout days",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutDayResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      },
      "post": {
        "tags": [
          "Sync"
        ],
        "summary": "Push workout days and templates with their blocks, exercises, and results",
        "description": "Set `kind` to `template` for a reusable coach-owned workout day. It must not be attached to a workout plan.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "records"
                ],
                "properties": {
                  "records": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/WorkoutDay"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synchronized workout days",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutDayResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/sync/nutrition-plans": {
      "get": {
        "tags": [
          "Sync"
        ],
        "summary": "Pull nutrition plans with their days and meals",
        "parameters": [
          {
            "$ref": "#/components/parameters/UpdatedAfter"
          }
        ],
        "responses": {
          "200": {
            "description": "Changed nutrition plans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NutritionPlanResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      },
      "post": {
        "tags": [
          "Sync"
        ],
        "summary": "Push nutrition plans with their days and meals",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "records"
                ],
                "properties": {
                  "records": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/NutritionPlan"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synchronized nutrition plans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NutritionPlanResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "parameters": {
      "SyncResource": {
        "name": "resource",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "users",
            "user-app-settings",
            "training-preferences",
            "training-locations",
            "body-metric-entries",
            "body-progress-photo-sessions",
            "exercise-profiles",
            "nutrition-profiles",
            "nutrition-log-media",
            "nutrition-log-entries",
            "nutrition-log-items",
            "nutrition-plans",
            "nutrition-days",
            "nutrition-meals",
            "workout-plans",
            "workout-days",
            "workout-blocks",
            "planned-exercises",
            "exercise-results",
            "subscriptions"
          ]
        }
      },
      "UpdatedAfter": {
        "name": "updated_after",
        "in": "query",
        "required": false,
        "description": "Only return records changed after this ISO 8601 timestamp.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "Authentication is required."
      },
      "ValidationError": {
        "description": "The request payload is invalid. Field-specific messages are returned in `errors`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "example": {
              "message": "The given data was invalid.",
              "errors": {
                "password": [
                  "The password must be at least 12 characters."
                ]
              }
            }
          }
        }
      },
      "Conflict": {
        "description": "The requested identity cannot be linked.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Coach": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CoachCollection": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Coach"
