{
  "openapi": "3.1.0",
  "info": {
    "title": "Wildforce API",
    "version": "1.0.0",
    "description": "API for Wildforce mobile clients. Authenticate with a Sanctum bearer token,\nthen use the sync endpoints to exchange user-owned records.\n"
  },
  "servers": [
    {
      "url": "http://wildforce.test"
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Feedback"
    },
    {
      "name": "Sync"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a user and issue a bearer token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in and issue a bearer token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/user": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get the authenticated user",
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/api/feedback": {
      "post": {
        "tags": [
          "Feedback"
        ],
        "summary": "Email feedback from the authenticated user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Feedback accepted and emailed."
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/sync/push": {
      "post": {
        "tags": [
          "Sync"
        ],
        "summary": "Push changed records for a registered resource",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncPushRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synchronized records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/sync/pull": {
      "get": {
        "tags": [
          "Sync"
        ],
        "summary": "Pull changed records for a registered resource",
        "parameters": [
          {
            "$ref": "#/components/parameters/SyncResource"
          },
          {
            "$ref": "#/components/parameters/UpdatedAfter"
          }
        ],
        "responses": {
          "200": {
            "description": "Changed records and the requested resource name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/sync/workout-days": {
      "get": {
        "tags": [
          "Sync"
        ],
        "summary": "Pull workout days with their blocks, exercises, and results",
        "parameters": [
          {
            "$ref": "#/components/parameters/UpdatedAfter"
          }
        ],
        "responses": {
          "200": {
            "description": "Changed workout days",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutDayResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      },
      "post": {
        "tags": [
          "Sync"
        ],
        "summary": "Push workout days with their blocks, exercises, and results",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "records"
                ],
                "properties": {
                  "records": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/WorkoutDay"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synchronized workout days",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutDayResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/sync/nutrition-plans": {
      "get": {
        "tags": [
          "Sync"
        ],
        "summary": "Pull nutrition plans with their days and meals",
        "parameters": [
          {
            "$ref": "#/components/parameters/UpdatedAfter"
          }
        ],
        "responses": {
          "200": {
            "description": "Changed nutrition plans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NutritionPlanResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      },
      "post": {
        "tags": [
          "Sync"
        ],
        "summary": "Push nutrition plans with their days and meals",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "records"
                ],
                "properties": {
                  "records": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/NutritionPlan"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synchronized nutrition plans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NutritionPlanResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "parameters": {
      "SyncResource": {
        "name": "resource",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "users",
            "user-app-settings",
            "training-preferences",
            "training-locations",
            "body-metric-entries",
            "body-progress-photo-sessions",
            "exercise-profiles",
            "nutrition-profiles",
            "nutrition-log-media",
            "nutrition-log-entries",
            "nutrition-log-items",
            "nutrition-plans",
            "nutrition-days",
            "nutrition-meals",
            "workout-plans",
            "workout-days",
            "workout-blocks",
            "planned-exercises",
            "exercise-results"
          ]
        }
      },
      "UpdatedAfter": {
        "name": "updated_after",
        "in": "query",
        "required": false,
        "description": "Only return records changed after this ISO 8601 timestamp.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "Authentication is required."
      },
      "ValidationError": {
        "description": "The request payload is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password",
          "password_confirmation",
          "device_name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "password_confirmation": {
            "type": "string",
            "format": "password"
          },
          "device_name": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "device_name"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "device_name": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "FeedbackRequest": {
        "type": "object",
        "required": [
          "category",
          "message"
        ],
        "properties": {
          "category": {
            "type": "string",
            "maxLength": 100
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "user",
          "token",
          "token_type"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          }
        }
      },
      "SyncPushRequest": {
        "type": "object",
        "required": [
          "resource",
          "records"
        ],
        "properties": {
          "resource": {
            "$ref": "#/components/parameters/SyncResource/schema"
          },
          "records": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/SyncRecord"
            }
          }
        }
      },
      "SyncResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncRecord"
            }
          },
          "meta": {
            "type": "object",
            "required": [
              "resource"
            ],
            "properties": {
              "resource": {
                "type": "string"
              }
            }
          }
        }
      },
      "SyncRecord": {
        "type": "object",
        "required": [
          "id",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": true
      },
      "WorkoutDay": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SyncRecord"
          },
          {
            "type": "object",
            "required": [
              "title",
              "blocks",
              "exercises"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SyncRecord"
                }
              },
              "exercises": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SyncRecord"
                }
              }
            }
          }
        ]
      },
      "WorkoutDayResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkoutDay"
            }
          }
        }
      },
      "NutritionPlan": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SyncRecord"
          },
          {
            "type": "object",
            "required": [
              "days"
            ],
            "properties": {
              "days": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SyncRecord"
                }
              }
            }
          }
        ]
      },
      "NutritionPlanResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NutritionPlan"
            }
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": [
          "message",
          "errors"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
